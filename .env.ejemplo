# Ruta a la carpeta que contiene tus apuntes privados (absoluta o relativa).
RUTA_APUNTES=../../apuntes-privados

# Fuente GitHub del catálogo LaTeX usado por el generador (acceso directo, sin clonar).
BIBLIOTECA_LATEX_GITHUB=https://github.com/nataliagamezbarea/apuntes-latex

# Ruta local instalada, necesaria al compilar los apuntes con LaTeX.
RUTA_BIBLIOTECA_LATEX=../../bibliotecas_latex

PUERTO_WEB=8000
MODELO_IA=qwen2.5vl:7b
TIEMPO_IA=900
# -1 deja que Ollama genere toda la respuesta que necesite.
TOKENS_MAX_IA=-1
NUM_CTX_IA=24576
CONCURRENCIA_IA=1
# Máximo permitido: 50. Aumenta este valor solo si el equipo tiene memoria suficiente.

# Límites locales configurables según el equipo.
MAX_MB_SUBIDA=512
MAX_ARCHIVOS_SUBIDA=300
MAX_MB_ZIP=256
MAX_PAGINAS_VISION=8
